{
  "name": "@towles-tool/comment-budget",
  "version": "1.0.0",
  "description": "A zero-config ratchet on comment volume: a change may not grow a file's comment excess, nor add a wall of comment.",
  "keywords": ["comments", "ai", "ci", "code-quality"],
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChrisTowles/towles-tool.git",
    "directory": "crates/comment-budget"
  },
  "bin": {
    "comment-budget": "comment-budget"
  },
  "files": ["comment-budget", "postinstall.js", "README.md", "LICENSE-MIT", "LICENSE-APACHE"],
  "scripts": {
    "postinstall": "node postinstall.js"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "optionalDependencies": {
    "@towles-tool/comment-budget-linux-x64-gnu": "1.0.0",
    "@towles-tool/comment-budget-linux-arm64-gnu": "1.0.0",
    "@towles-tool/comment-budget-darwin-arm64": "1.0.0"
  }
}
