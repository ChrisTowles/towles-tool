{
  "name": "towles-tool",
  "version": "0.1.2",
  "private": true,
  "workspaces": [
    "apps/client"
  ],
  "engines": {
    "bun": ">=1.3",
    "node": ">=24"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "dev": "node scripts/dev-port.mjs",
    "start": "node scripts/start.mjs",
    "dev:drive": "node scripts/dev-drive.mjs",
    "drive": "node scripts/drive.mjs",
    "clean": "cargo clean && rm -rf apps/client/dist node_modules apps/client/node_modules",
    "build": "tauri build",
    "tauri": "tauri",
    "client:dev": "bun run --filter @towles-tool/client dev",
    "e2e": "node scripts/e2e.mjs",
    "e2e:run": "node scripts/e2e.mjs --no-build",
    "release:bump": "node scripts/release-version-bump.mjs",
    "test:scripts": "node --test \"scripts/*.test.mjs\"",
    "check:md-links": "node scripts/check-md-links.mjs",
    "check:bundle": "node scripts/bundle-budget.mjs",
    "typecheck:scripts": "tsc -p scripts/tsconfig.json"
  },
  "overrides": {
    "@wdio/native-utils": "2.5.0",
    "@codingame/monaco-vscode-api": "35.0.3",
    "@codingame/monaco-vscode-editor-api": "35.0.3",
    "@hono/node-server": "^2.0.12",
    "dompurify": "^3.4.12",
    "serialize-javascript": "^7.0.7",
    "minimatch": "^10.2.5",
    "@puppeteer/browsers": "^3.2.4",
    "chokidar": "^4.0.3",
    "deepmerge-ts": "^8.0.2",
    "js-yaml": "^4.3.1",
    "nanoid": "^3.3.20",
    "postcss": "^8.5.29",
    "postcss-selector-parser": "^7.1.6",
    "smol-toml": "^1.9.1",
    "source-map-js": "^1.2.2",
    "tinypool": "^2.2.0",
    "undici": "^7.30.0",
    "brace-expansion": "^5.0.12"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.1",
    "@wdio/cli": "^9.29.1",
    "@wdio/local-runner": "^9.29.1",
    "@wdio/mocha-framework": "^9.29.1",
    "@wdio/spec-reporter": "^9.29.1",
    "@wdio/tauri-plugin": "^1.2.0",
    "@wdio/tauri-service": "^1.2.0",
    "better-result": "^2.10.0",
    "tsx": "^4.23.0"
  }
}
