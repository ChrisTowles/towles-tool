{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Towles Tool",
  "version": "0.2.0",
  "identifier": "dev.towles.tool",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../../apps/client/dist",
    "beforeDevCommand": "bun run --filter @towles-tool/client dev",
    "beforeBuildCommand": "bun run --filter @towles-tool/client build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "create": false,
        "label": "main",
        "title": "Towles Tool",
        "width": 1440,
        "height": 900,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENEQTJGQkE1NEQxODdCNDgKUldSSWV4aE5wZnVpemQvK1A2MXBJVUxjK29GSnVsb3RsUis5ZzdjZ2NNNWtmRUZ0YS9yTTc4TEIK",
      "endpoints": [
        "https://github.com/ChrisTowles/towles-tool/releases/latest/download/latest.json"
      ]
    }
  }
}
